# Environment Configuration for AWS RDS PostgreSQL & Vercel
PORT=5000
NODE_ENV=production

# AWS RDS PostgreSQL Connection String Format:
# postgresql://[USERNAME]:[PASSWORD]@[AWS_RDS_ENDPOINT]:5432/[DB_NAME]?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:YourSecurePassword@fabrication-db.c123456789.us-east-1.rds.amazonaws.com:5432/fabrication_db?schema=public&sslmode=require"

# JWT Secret for Owner Admin
JWT_SECRET="fabrication_super_secret_jwt_key_2026_admin"
