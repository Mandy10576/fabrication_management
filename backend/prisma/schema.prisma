generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  password          String
  name              String
  role              String              @default("ADMIN")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  pushSubscriptions PushSubscription[]
}

// Browser push subscriptions — one row per device/browser that clicked
// "Enable Notifications". A user can have several (phone + desktop, etc).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model CompanyDetails {
  id              String   @id @default(uuid())
  companyName     String
  ownerName       String
  gstin           String?
  pan             String?
  email           String?
  phone           String?
  address         String?
  bankName        String?
  accountNumber   String?
  ifscCode        String?
  branch          String?
  upiId           String?
  logoUrl         String?
  termsConditions String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  state           String?
}

model FinancialYear {
  id         String      @id @default(uuid())
  year       String      @unique
  startDate  DateTime
  endDate    DateTime
  isCurrent  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  clients    Client[]
  invoices   Invoice[]
  quotations Quotation[]
}

model Client {
  id              String        @id @default(uuid())
  companyName     String
  contactPerson   String
  mobile          String
  email           String?
  gstin           String?
  pan             String?
  address         String
  notes           String?
  financialYearId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  state           String?
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  invoices        Invoice[]
  projects        Project[]
  quotations      Quotation[]

  @@index([financialYearId])
  @@index([companyName])
}

model RateMaster {
  id          String   @id @default(uuid())
  serviceName String
  hsnSac      String   @default("")
  unit        String   @default("sq ft")
  rate        Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceName])
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String
  financialYearId String
  clientId        String
  date            DateTime
  dueDate         DateTime?
  gstType         String        @default("CGST_SGST")
  gstRate         Float         @default(18.0)
  subtotal        Float
  cgstAmount      Float         @default(0)
  sgstAmount      Float         @default(0)
  igstAmount      Float         @default(0)
  totalTax        Float         @default(0)
  discount        Float         @default(0)
  grandTotal      Float
  amountInWords   String
  amountReceived  Float         @default(0)
  balanceDue      Float
  status          String        @default("UNPAID")
  notes           String?
  terms           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  state           String?
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]

  @@index([financialYearId])
  @@index([clientId])
  @@index([status])
  @@index([gstType])
  @@index([date])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  hsnSac      String?
  quantity    Float
  unit        String
  rate        Float
  amount      Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Quotation {
  id                 String          @id @default(uuid())
  quotationNumber    String
  financialYearId    String
  clientId           String
  date               DateTime
  validUntil         DateTime?
  gstType            String          @default("CGST_SGST")
  gstRate            Float           @default(18.0)
  subtotal           Float
  taxAmount          Float           @default(0)
  discount           Float           @default(0)
  grandTotal         Float
  status             String          @default("PENDING")
  convertedInvoiceId String?
  notes              String?
  terms              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  state              String?
  client             Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  financialYear      FinancialYear   @relation(fields: [financialYearId], references: [id])
  items              QuotationItem[]

  @@index([financialYearId])
  @@index([clientId])
  @@index([status])
  @@index([date])
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  description String
  hsnSac      String?
  quantity    Float
  unit        String
  rate        Float
  amount      Float
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model Payment {
  id          String   @id @default(uuid())
  invoiceId   String
  amount      Float
  paymentDate DateTime @default(now())
  paymentMode String   @default("CASH")
  referenceNo String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paymentDate])
}

model Employee {
  id                  String          @id @default(uuid())
  name                String
  mobile              String
  address             String?
  joiningDate         DateTime
  monthlySalary       Float
  salaryCycleStartDay Int             @default(1)
  deductionBasis      String          @default("CALENDAR_DAYS")
  isActive            Boolean         @default(true)
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  advances            Advance[]
  attendance          Attendance[]
  salaryPayments      SalaryPayment[]
  workLogs            WorkLog[]       @relation("EmployeeToWorkLog")

  @@index([isActive])
  @@index([name])
}

model Attendance {
  id         String   @id @default(uuid())
  employeeId String
  date       DateTime
  status     String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

model Advance {
  id          String   @id @default(uuid())
  employeeId  String
  amount      Float
  advanceDate DateTime @default(now())
  paymentMode String   @default("CASH")
  referenceNo String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([advanceDate])
}

model SalaryPayment {
  id          String   @id @default(uuid())
  employeeId  String
  cycleStart  DateTime
  amount      Float
  paymentDate DateTime @default(now())
  paymentMode String   @default("CASH")
  referenceNo String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([employeeId, cycleStart])
  @@index([paymentDate])
}

model Project {
  id                 String     @id @default(uuid())
  clientId           String
  name               String
  siteAddress        String
  contactNumber      String?
  startDate          DateTime
  expectedCompletion DateTime?
  status             String     @default("ACTIVE")
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  client             Client     @relation(fields: [clientId], references: [id])
  workItems          WorkItem[]
  workLogs           WorkLog[]

  @@index([clientId])
  @@index([status])
  @@index([name])
}

model WorkItem {
  id        String   @id @default(uuid())
  projectId String
  name      String
  status    String   @default("PENDING")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, status])
}

model WorkLog {
  id              String         @id @default(uuid())
  projectId       String
  visitDate       DateTime
  visitTime       String?
  workDone        String?
  workInProgress  String?
  workPending     String?
  amount          Float          @default(0)
  paymentReceived Float          @default(0)
  paymentMode     String         @default("CASH")
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  materials       MaterialUsed[]
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  photos          WorkLogPhoto[]
  employees       Employee[]     @relation("EmployeeToWorkLog")

  @@index([projectId])
  @@index([projectId, visitDate])
  @@index([visitDate])
}

model MaterialUsed {
  id           String  @id @default(uuid())
  workLogId    String
  materialName String
  quantity     Float
  unit         String
  workLog      WorkLog @relation(fields: [workLogId], references: [id], onDelete: Cascade)

  @@index([workLogId])
}

model WorkLogPhoto {
  id        String   @id @default(uuid())
  workLogId String
  url       String
  createdAt DateTime @default(now())
  workLog   WorkLog  @relation(fields: [workLogId], references: [id], onDelete: Cascade)

  @@index([workLogId])
}

// ---------------------------------------------------------------------------
// Rent module: Area -> Building -> Room -> Tenancy (+ Tenant, Payments,
// Electricity). RentTenancy IS the tenant-history mechanism — a room's
// current tenant is its RentTenancy with status ACTIVE/endDate null; past
// tenants are simply its ended RentTenancy rows. Nothing here is ever
// hard-deleted once it has history; deletion is only exposed (app-guarded)
// for empty Areas/Buildings/Rooms/Tenants with no children/history.
// ---------------------------------------------------------------------------

model RentArea {
  id        String        @id @default(uuid())
  name      String
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  buildings RentBuilding[]

  @@index([name])
}

model RentBuilding {
  id                 String              @id @default(uuid())
  areaId             String
  area               RentArea            @relation(fields: [areaId], references: [id])
  name               String
  address            String
  totalRooms         Int                 @default(0)
  electricityBilling Boolean             @default(false)
  electricityRate    Float               @default(10) // ₹ per unit, editable from the building form
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  rooms              RentRoom[]

  @@index([areaId])
  @@index([name])
}

model RentRoom {
  id               String                @id @default(uuid())
  buildingId       String
  building         RentBuilding          @relation(fields: [buildingId], references: [id])
  roomNumber       String
  status           String                @default("VACANT") // VACANT, OCCUPIED
  monthlyRent      Float
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tenancies        RentTenancy[]
  electricityBills RentElectricityBill[]

  @@index([buildingId])
  @@index([status])
}

model RentTenant {
  id             String               @id @default(uuid())
  name           String
  mobile         String
  address        String?
  aadhaarNumber  String?
  panNumber      String?
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  documents      RentTenantDocument[]
  tenancies      RentTenancy[]

  @@index([mobile])
  @@index([name])
}

model RentTenantDocument {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       RentTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  docType      String // AADHAAR, PAN, OTHER
  url          String
  originalName String?
  createdAt    DateTime   @default(now())

  @@index([tenantId])
}

model RentTenancy {
  id          String        @id @default(uuid())
  roomId      String
  room        RentRoom      @relation(fields: [roomId], references: [id])
  tenantId    String
  tenant      RentTenant    @relation(fields: [tenantId], references: [id])
  startDate   DateTime
  endDate     DateTime?
  monthlyRent Float // snapshot of Room.monthlyRent at tenancy start
  status      String        @default("ACTIVE") // ACTIVE, ENDED
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  payments    RentPayment[]
  electricityBills RentElectricityBill[]
  electricityPayments RentElectricityPayment[]

  @@index([roomId])
  @@index([tenantId])
  @@index([status])
}

model RentPayment {
  id          String      @id @default(uuid())
  tenancyId   String
  tenancy     RentTenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  cycleStart  DateTime
  amount      Float
  paymentDate DateTime    @default(now())
  paymentMode String      @default("CASH") // CASH, UPI, BANK_TRANSFER, CHEQUE, OTHER
  referenceNo String?
  notes       String?
  // Correlates this row with an RentElectricityPayment created in the same
  // "combined" Record Payment submission, so the two can be displayed
  // together as one receipt without a dedicated header table.
  batchId     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([tenancyId])
  @@index([tenancyId, cycleStart])
  @@index([batchId])
}

model RentElectricityBill {
  id             String       @id @default(uuid())
  roomId         String
  room           RentRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenancyId      String?
  tenancy        RentTenancy? @relation(fields: [tenancyId], references: [id])
  billDate       DateTime     @default(now())
  previousReading Float?
  currentReading  Float?
  ratePerUnit     Float? // snapshot of Building.electricityRate at billing time — never rewritten by later rate changes
  unitsConsumed  Float?
  amount         Float
  // status/amountPaid/paymentDate/paymentMode are denormalized and
  // recomputed after every payment mutation — same re-aggregate-and-rederive
  // pattern as Invoice/RentTenancy — never trust them as the source of truth,
  // that's the `payments` ledger below.
  status         String       @default("PENDING") // PENDING, PARTIAL, PAID
  amountPaid     Float        @default(0)
  paymentDate    DateTime?
  paymentMode    String? // CASH, UPI, BANK_TRANSFER, CHEQUE, OTHER
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  payments       RentElectricityPayment[]

  @@index([roomId])
  @@index([status])
}

model RentElectricityPayment {
  id          String               @id @default(uuid())
  billId      String
  bill        RentElectricityBill  @relation(fields: [billId], references: [id], onDelete: Cascade)
  // The tenancy the underlying bill was billed under (not necessarily
  // whoever is paying it) — lets a room's combined-payment history be
  // grouped per tenancy even if unpaid electricity carries over a move-out.
  tenancyId   String?
  tenancy     RentTenancy?         @relation(fields: [tenancyId], references: [id])
  amount      Float
  paymentDate DateTime             @default(now())
  paymentMode String               @default("CASH") // CASH, UPI, BANK_TRANSFER, CHEQUE, OTHER
  referenceNo String?
  notes       String?
  // Correlates this row with a RentPayment created in the same "combined"
  // Record Payment submission — see RentPayment.batchId.
  batchId     String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([billId])
  @@index([tenancyId])
  @@index([batchId])
}
