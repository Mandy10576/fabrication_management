datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyDetails {
  id              String   @id @default(uuid())
  companyName     String
  ownerName       String
  gstin           String?
  pan             String?
  email           String?
  phone           String?
  address         String?
  bankName        String?
  accountNumber   String?
  ifscCode        String?
  branch          String?
  upiId           String?
  logoUrl         String?
  termsConditions String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FinancialYear {
  id          String      @id @default(uuid())
  year        String      @unique // e.g. "2025-26", "2026-27"
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  clients     Client[]
  invoices    Invoice[]
  quotations  Quotation[]
}

model Client {
  id              String        @id @default(uuid())
  companyName     String
  contactPerson   String
  mobile          String
  email           String?
  gstin           String?
  pan             String?
  address         String
  notes           String?
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  invoices        Invoice[]
  quotations      Quotation[]
  projects        Project[]

  @@index([financialYearId])
  @@index([companyName])
}

model RateMaster {
  id          String   @id @default(uuid())
  serviceName String
  hsnSac      String   @default("")
  unit        String   @default("sq ft")
  rate        Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceName])
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date            DateTime
  dueDate         DateTime?
  gstType         String        @default("CGST_SGST") // CGST_SGST, IGST, NON_GST
  gstRate         Float         @default(18.0)
  subtotal        Float
  cgstAmount      Float         @default(0)
  sgstAmount      Float         @default(0)
  igstAmount      Float         @default(0)
  totalTax        Float         @default(0)
  discount        Float         @default(0)
  grandTotal      Float
  amountInWords   String
  amountReceived  Float         @default(0)
  balanceDue      Float
  status          String        @default("UNPAID") // PAID, PARTIAL, UNPAID
  notes           String?
  terms           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           InvoiceItem[]
  payments        Payment[]

  @@index([financialYearId])
  @@index([clientId])
  @@index([status])
  @@index([gstType])
  @@index([date])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  hsnSac      String?
  quantity    Float
  unit        String
  rate        Float
  amount      Float

  @@index([invoiceId])
}

model Quotation {
  id                 String          @id @default(uuid())
  quotationNumber    String
  financialYearId    String
  financialYear      FinancialYear   @relation(fields: [financialYearId], references: [id])
  clientId           String
  client             Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date               DateTime
  validUntil         DateTime?
  gstType            String          @default("CGST_SGST") // CGST_SGST, IGST, NON_GST
  gstRate            Float           @default(18.0)
  subtotal           Float
  taxAmount          Float           @default(0)
  discount           Float           @default(0)
  grandTotal         Float
  status             String          @default("PENDING") // PENDING, ACCEPTED, REJECTED, CONVERTED
  convertedInvoiceId String?
  notes              String?
  terms              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  items              QuotationItem[]

  @@index([financialYearId])
  @@index([clientId])
  @@index([status])
  @@index([date])
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  hsnSac      String?
  quantity    Float
  unit        String
  rate        Float
  amount      Float

  @@index([quotationId])
}

model Payment {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Float
  paymentDate DateTime @default(now())
  paymentMode String   @default("CASH") // CASH, UPI, BANK_TRANSFER, CHEQUE, OTHER
  referenceNo String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
  @@index([paymentDate])
}

model Employee {
  id                  String   @id @default(uuid())
  name                String
  mobile              String
  address             String?
  joiningDate         DateTime
  monthlySalary       Float
  salaryCycleStartDay Int      @default(1) // 1-31, day-of-month cycle starts
  deductionBasis      String   @default("CALENDAR_DAYS") // CALENDAR_DAYS, WORKING_DAYS
  isActive            Boolean  @default(true)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  attendance     Attendance[]
  advances       Advance[]
  salaryPayments SalaryPayment[]
  workLogs       WorkLog[]

  @@index([isActive])
  @@index([name])
}

model Attendance {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime // UTC-midnight-normalized calendar day
  status     String // PRESENT, ABSENT, PAID_LEAVE, UNPAID_LEAVE, HOLIDAY
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

model Advance {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount      Float
  advanceDate DateTime @default(now())
  paymentMode String   @default("CASH") // CASH, UPI, BANK_TRANSFER, OTHER
  referenceNo String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([advanceDate])
}

model SalaryPayment {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycleStart  DateTime // identifies which salary cycle this payment applies to
  amount      Float
  paymentDate DateTime @default(now())
  paymentMode String   @default("CASH") // CASH, UPI, BANK_TRANSFER, CHEQUE, OTHER
  referenceNo String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([employeeId, cycleStart])
  @@index([paymentDate])
}

model Project {
  id                 String     @id @default(uuid())
  clientId           String
  client             Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  name               String
  siteAddress        String
  contactNumber      String?
  startDate          DateTime
  expectedCompletion DateTime?
  status             String     @default("ACTIVE") // ACTIVE, COMPLETED, ON_HOLD
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  workItems          WorkItem[]
  workLogs           WorkLog[]

  @@index([clientId])
  @@index([status])
  @@index([name])
}

model WorkItem {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String // e.g. "Main Gate", "Shed Structure"
  status     String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, status])
}

model WorkLog {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visitDate       DateTime // UTC-midnight-normalized calendar date
  visitTime       String? // free-text "HH:mm"
  workDone        String?
  workInProgress  String?
  workPending     String?
  amount          Float     @default(0) // work value for this visit
  paymentReceived Float     @default(0)
  paymentMode     String    @default("CASH") // CASH, UPI, BANK, OTHER
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employees       Employee[] // implicit m:n - "employees who worked"
  materials       MaterialUsed[]
  photos          WorkLogPhoto[]

  @@index([projectId])
  @@index([projectId, visitDate])
  @@index([visitDate])
}

model MaterialUsed {
  id           String  @id @default(uuid())
  workLogId    String
  workLog      WorkLog @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  materialName String
  quantity     Float
  unit         String

  @@index([workLogId])
}

model WorkLogPhoto {
  id        String   @id @default(uuid())
  workLogId String
  workLog   WorkLog  @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  url       String // "/uploads/worklog_<timestamp>_<n>.<ext>"
  createdAt DateTime @default(now())

  @@index([workLogId])
}

